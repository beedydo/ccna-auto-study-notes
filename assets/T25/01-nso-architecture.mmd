flowchart TB
  subgraph NB["Northbound: how you talk to NSO"]
    direction LR
    cli["NSO CLI<br/>(J / C style)"]
    web["Web UI"]
    rc["RESTCONF<br/>:8080/restconf"]
    nc["NETCONF<br/>:2022"]
    jr["JSON-RPC<br/>(Web UI uses it)"]
  end
  subgraph CORE["NSO core (one transaction engine)"]
    direction LR
    sm["Service Manager<br/>service YANG + template / Python<br/>FASTMAP"]
    dm["Device Manager<br/>sync-from / sync-to / check-sync"]
    cdb[("CDB<br/>services + every device's config<br/>as YANG")]
    sm --> dm
    sm <--> cdb
    dm <--> cdb
  end
  subgraph SB["Southbound: NEDs (one per device type)"]
    direction LR
    ned1["cisco-ios-cli NED<br/>→ CLI over SSH"]
    ned2["cisco-iosxr-cli NED<br/>→ CLI over SSH"]
    ned3["juniper-junos-nc NED<br/>→ NETCONF"]
    ned4["SNMP / generic NED<br/>→ SNMP SET / REST"]
  end
  NB --> CORE
  dm --> ned1 & ned2 & ned3 & ned4
  ned1 --> d1["ios0"]
  ned2 --> d2["xr0"]
  ned3 --> d3["junos0"]
  ned4 --> d4["other vendor"]
  classDef rec fill:#d1ecf1,stroke:#17a2b8,stroke-width:2px
  classDef safe fill:#d4edda,stroke:#28a745,stroke-width:2px
  classDef part fill:#fff3cd,stroke:#e0a800,stroke-width:2px
  class sm,dm rec
  class cdb safe
  class ned1,ned2,ned3,ned4 part
