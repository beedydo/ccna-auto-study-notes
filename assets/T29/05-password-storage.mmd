flowchart TB
    subgraph REG["① Register"]
        direction LR
        P1["password"] --> S1["+ random salt<br/>os.urandom(16)"] --> K1["PBKDF2-SHA256<br/>600 000 iterations"] --> DB[("store<br/>algo$iter$salt$hash")]
    end
    subgraph LOGIN["② Log in"]
        direction LR
        P2["typed password"] --> K2["re-hash with the<br/>STORED salt + iterations"] --> CMP{"compare_digest<br/>equal?"}
        CMP -->|yes| Y["login OK"]
        CMP -->|no| N["reject"]
    end
    REG --> LOGIN
    classDef bad fill:#fde8e8,stroke:#dc3545,color:#1d1d1f
    classDef good fill:#d4edda,stroke:#28a745,color:#1d1d1f
    classDef rec fill:#dbe9ff,stroke:#2563eb,color:#1d1d1f
    class S1,K1,DB,K2 rec
    class Y good
    class N bad
