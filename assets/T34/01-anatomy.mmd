flowchart LR
    subgraph INV["inventory.yml + group_vars/ + host_vars/"]
        direction TB
        G1["group ios_switches<br/>sw1 · sw2"]:::good
        G2["group nxos_switches<br/>n9k1"]:::dim
    end
    subgraph PB["site.yml = list of PLAYS"]
        direction TB
        P1["PLAY 1<br/>hosts: ios_switches<br/>(network_cli from group_vars)"]:::ans
        P2["PLAY 2<br/>hosts: ios_switches<br/>(play vars: httpapi)"]:::ans
    end
    subgraph TK["each play = list of TASKS (top to bottom)"]
        direction TB
        T1["- name: Read the VLAN table<br/>  cisco.ios.ios_command: ...<br/>  register: vlan_out"]
        T2["- name: Create VLANs that are missing<br/>  cisco.ios.ios_config: ...<br/>  loop / when / notify"]
        H["handlers:<br/>Save running config"]:::warn
    end
    G1 -- "hosts: matches group" --> P1
    G1 --> P2
    P1 --> T1
    P1 --> T2
    T2 -. "notify (only if changed)" .-> H
    classDef good fill:#e3f6ee,stroke:#28a745,color:#1d1d1f
    classDef ans fill:#d1ecf1,stroke:#17a2b8,color:#1d1d1f,font-weight:bold
    classDef warn fill:#fff3cd,stroke:#e0a800,color:#1d1d1f
    classDef dim fill:#f2f2f2,stroke:#999,color:#777
