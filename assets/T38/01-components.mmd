flowchart LR
    H["💻 Host<br/>10.10.10.21/24<br/>gw 10.10.10.1"]
    SW["🔀 Switch · L2<br/>reads dst <b>MAC</b><br/>MAC table, VLANs<br/>one broadcast domain per VLAN"]
    R["🧭 Router / L3 switch · L3<br/>reads dst <b>IP</b><br/>routing table, longest match<br/>is the default gateway"]
    FW["🛡️ Firewall · L3-L4+<br/>reads IP + port + <b>state</b><br/>zones: inside / dmz / outside<br/>implicit deny"]
    LB["⚖️ Load balancer · L4-L7<br/>owns the <b>VIP</b><br/>health checks the pool<br/>rewrites dst to a real server"]
    S1["🖥️ web1 (up)"]
    S2["🖥️ web2 (down)"]
    H --> SW --> R --> FW --> LB
    LB --> S1
    LB -.-x S2
    AP["📶 Access point<br/>radio ↔ wired"] -- "CAPWAP UDP 5246 ctrl / 5247 data" --> WLC["🎛️ WLC<br/>central config, RF, roaming"]
    style SW fill:#e3f1f8,stroke:#17a2b8
    style R fill:#cfe2ff,stroke:#0d6efd,stroke-width:3px
    style FW fill:#fde8e8,stroke:#dc3545
    style LB fill:#fff3cd,stroke:#e0a800
    style S1 fill:#d4edda,stroke:#28a745
    style S2 fill:#f8d7da,stroke:#dc3545,stroke-dasharray: 5 5
    style AP fill:#e3f6ee,stroke:#2fb380
    style WLC fill:#e3f6ee,stroke:#2fb380
