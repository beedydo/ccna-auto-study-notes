    OK -- Yes --> D["1. save page data"] --> N["2. url = Link rel=next<br/>save it as bookmark"]
    N --> M{"next exists?"}
    M -- Yes --> G
    M -- No --> E(["Done: delete bookmark"])
    G -. "crash here" .-> X["bookmark still points at<br/>the page not yet saved"]
