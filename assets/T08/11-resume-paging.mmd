flowchart LR
    S(["Start script"]) --> B{"Bookmark file<br/>exists?"}
    B -- No --> F["url = page 1"]
    B -- Yes --> R["url = saved bookmark<br/>(startingAfter=c020)"]
    F --> G["GET url"]
    R --> G
