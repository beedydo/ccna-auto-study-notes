flowchart TB
    REG[("Registry: Docker Hub or private<br/>[host/]namespace/repo:tag")]
    subgraph HOST["Docker host: Engine (dockerd) builds and runs"]
        direction LR
        DF["Dockerfile<br/>+ build context labs/T27/"]
        BASE["Base image<br/>python:3.12-slim"]
        IMG["Image<br/>t27-mock-api:1.0<br/>read-only layers"]
        C1["Container t27-api<br/>image + writable layer<br/>+ running process"]
        DF == "② docker build" ==> IMG
        BASE -- "FROM" --> IMG
        IMG == "④ docker run" ==> C1
    end
    REG -. "① docker pull" .-> BASE
    IMG -. "③ docker push" .-> REG
    style DF fill:#fff3cd,stroke:#e0a800
    style BASE fill:#d1ecf1,stroke:#17a2b8
    style IMG fill:#d1ecf1,stroke:#17a2b8
    style C1 fill:#d4edda,stroke:#28a745
    style REG fill:#e8dcf7,stroke:#7b4bc4
    style HOST fill:#f8f9fa,stroke:#6c757d
