flowchart LR
    C["Client wants<br/>device 1"]
    C --> R["<b>REST</b><br/>GET /api/v1/devices/1<br/><i>action = HTTP method<br/>target = URI noun</i>"]
    C --> J["<b>JSON-RPC</b><br/>POST /jsonrpc<br/>{&quot;method&quot;: &quot;getDevice&quot;,<br/>&quot;params&quot;: {&quot;id&quot;: 1}}<br/><i>action = method in body</i>"]
    C --> S["<b>SOAP</b><br/>POST /soap<br/>SOAPAction: &quot;GetDevice&quot;<br/>&lt;Envelope&gt;&lt;Body&gt;&lt;GetDevice&gt;<br/><i>action = XML operation</i>"]
    R --> RR["200 + JSON<br/>404 if missing"]
    J --> JR["HTTP 200 always<br/>result OR error object"]
    S --> SR["200 Envelope<br/>500 + soap:Fault"]
