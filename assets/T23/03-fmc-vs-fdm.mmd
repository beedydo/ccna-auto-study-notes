flowchart LR
    subgraph C["FMC: central (many firewalls)"]
        direction TB
        CS["Script"] -->|"POST .../auth/generatetoken<br/>Basic auth"| CF["FMC"]
        CF -->|"token in header<br/>X-auth-access-token"| CS
        CF --> C1["FTD"]
        CF --> C2["FTD"]
        CF --> C3["FTD"]
    end
    subgraph O["FDM: on-box (one firewall)"]
        direction TB
        OS["Script"] -->|"POST /api/fdm/latest/fdm/token<br/>JSON grant_type=password"| OF["FDM on the FTD itself"]
        OF -->|"access_token<br/>Authorization: Bearer"| OS
    end
    classDef rec fill:#cfe2ff,stroke:#0d6efd,stroke-width:2px
    classDef box fill:#ffffff,stroke:#2b2b2b,stroke-width:2px
    classDef fw fill:#d4edda,stroke:#28a745
    class CF rec
    class OF box
    class C1,C2,C3 fw
