flowchart TB
    subgraph YOU["You"]
        direction LR
        A["Admin browser<br/>dashboard.meraki.com"]
        S["Python script<br/>Dashboard API + API key"]
    end
    subgraph CLOUD["Meraki cloud = the controller (nothing on-prem)"]
        direction LR
        D["Dashboard<br/>config + monitoring"]
        API["api.meraki.com/api/v1"]
    end
    subgraph SITE["One Meraki network (site SG-HQ)"]
        direction LR
        U["Users / clients"] ==> MR["MR36<br/>wireless AP"] ==> MS["MS120<br/>switch"] ==> MX["MX68<br/>security appliance"]
        MV["MV12<br/>camera"] ==> MS
    end
    A -- HTTPS --> D
    S -- "HTTPS REST" --> API
    API --- D
    CLOUD <-. "management tunnel only (device dials out); user data stays on site" .-> SITE
    classDef blue fill:#d6e4ff,stroke:#2f5bd3,color:#111
    classDef green fill:#d4edda,stroke:#28a745,color:#111
    classDef grey fill:#f2f2f2,stroke:#555,color:#111
    class S,API blue
    class MX,MS,MR,MV green
    class A,D,U grey
