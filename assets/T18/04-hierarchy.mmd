flowchart TD
    O["GET /organizations"] -->|"pick id → organizationId"| N["GET /organizations/{organizationId}/networks"]
    N -->|"pick id → networkId"| D["GET /networks/{networkId}/devices"]
    N -->|"networkId"| C["GET /networks/{networkId}/clients"]
    D -->|"serial e.g. Q2HP-3WCD-7KZE"| S["GET /devices/{serial}"]
    C -->|"recentDeviceSerial"| S
    S -->|"serial"| DC["GET /devices/{serial}/clients"]
