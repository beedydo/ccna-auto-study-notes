flowchart LR
    subgraph CLI["Screen-scraping (unstructured)"]
        direction TB
        C1["send 'show ip interface brief'"] --> C2["free-form text<br/>columns differ per OS / release"]
        C2 --> C3["regex per OS"]
        C3 --> C4["IOS XE: 4 ports parsed"]
        C3 --> C5["NX-OS: 0 ports parsed<br/>(different layout, Eth1/1)"]
    end
    subgraph MD["Model-driven (structured)"]
        direction TB
        D1["GET openconfig-interfaces:interfaces"] --> D2["JSON shaped by the YANG model<br/>same keys on every OS"]
        D2 --> D3["i['state']['oper-status']"]
        D3 --> D4["IOS XE + NX-OS:<br/>all ports, no parsing"]
    end
