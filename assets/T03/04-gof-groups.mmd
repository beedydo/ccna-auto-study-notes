    ST --> AD["Adapter"]
    ST --> DE["Decorator"]
    BE --> OB["Observer<br/>blueprint 1.6"]
    BE --> SR["Strategy"]
    AR --> MVC["MVC<br/>blueprint 1.6"]
    MVC -. "uses" .-> OB
