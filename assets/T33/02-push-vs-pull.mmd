flowchart LR
    subgraph PUSH["PUSH: controller starts the connection"]
        direction TB
        C["Control node<br/>(Ansible / Terraform / NSO / Salt master)"]:::ans
        C -- "SSH / NETCONF / HTTPS" --> R1["router"]
        C -- "SSH / NETCONF / HTTPS" --> R2["switch"]
        C -- "API" --> R3["cloud / controller"]
    end
    subgraph PULL["PULL: agent on the node starts the connection"]
        direction TB
        S["Puppet primary server<br/>Chef Infra Server"]:::good
        A1["node + Puppet agent"] -- "every 30 min:<br/>fetch catalog" --> S
        A2["node + Chef Infra Client"] -- "periodically:<br/>fetch cookbooks" --> S
    end
    PUSH ~~~ PULL
